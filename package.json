{
  "name": "bplist-creator",
  "version": "0.2.0",
  "description": "Binary Mac OS X Plist (property list) creator.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.js",
    "lint": "eslint .",
    "test": "vitest run",
    "smoke": "npm run build && node smoke.cjs",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nearinfinity/node-bplist-creator.git"
  },
  "keywords": [
    "bplist",
    "plist",
    "creator"
  ],
  "author": "Joe Ferner",
  "license": "MIT",
  "dependencies": {
    "stream-buffers": "3.0.x"
  },
  "devDependencies": {
    "@eslint/js": "10.0.x",
    "bplist-parser": "0.3.x",
    "esbuild": "0.28.x",
    "eslint": "10.10.x",
    "globals": "17.12.x",
    "vitest": "5.0.x"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
